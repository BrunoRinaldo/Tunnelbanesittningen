# Enklaste vägen: en nyckel, ingen restriction. Byt namn på filen till .env
GOOGLE_API_KEY=

# Eller dela upp den (frivilligt):
# GOOGLE_SERVER_KEY=   # Application restrictions: None. Geocoding + Distance Matrix
# GOOGLE_BROWSER_KEY=  # Websites: http://localhost:8000/* och http://127.0.0.1:8000/*

# Comms-sidan (SMS-utskick): 46elks-konto, https://46elks.se
# Utan dessa kör comms-sidan i "ej konfigurerat" läge - knapparna funkar men
# inget skickas, det loggas bara som "skipped".
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_FROM=TBS

# Ditt eget mobilnummer (svenskt format). "Skicka testutskick"-knappen på
# comms-sidan skickar då en riktig, ifylld kopia av varje mallvariant hit, så
# du kan läsa igenom dem på en riktig telefon innan du låser upp de riktiga
# utskicken. Tom = knappen döljs.
DUBBLE_CHECK_TEXTS_TO_NUMBER=
